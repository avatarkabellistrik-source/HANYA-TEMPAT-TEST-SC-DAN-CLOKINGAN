/* Theme enqueue scripts */
function book_publisher_agency_scripts() {
	wp_enqueue_style( 'book-publisher-agency-font', book_publisher_agency_font_url(), array() );
	wp_enqueue_style( 'bootstrap-style', get_template_directory_uri().'/assets/css/bootstrap.css' );
	wp_enqueue_style( 'book-publisher-agency-block-style', get_theme_file_uri('/assets/css/blocks.css') );
	wp_enqueue_style( 'animate-style', get_template_directory_uri().'/assets/css/animate.css' );
	wp_enqueue_style( 'book-publisher-agency-basic-style', get_stylesheet_uri() );
	wp_style_add_data('book-publisher-agency-basic-style', 'rtl', 'replace');
	/* Inline style sheet */
