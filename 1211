		return;
	}
	echo 'class="' . esc_attr( $classes ) . '"';
}

/**
 * Adds "is-IE" class to body if the user is on Internet Explorer.
 *
 * @since Altamash College Of Physical-Therapy 1.0
 * @deprecated Altamash College Of Physical-Therapy 2.8 Removed Internet Explorer support.
 *
 * @return void
 */
function altamashcollegeofphysicaltherapy_add_ie_class() {
	$script  = "
		if ( -1 !== navigator.userAgent.indexOf('MSIE') || -1 !== navigator.appVersion.indexOf('Trident/') ) {
			document.body.classList.add('is-IE');
		}
	";
	$script .= '//# sourceURL=' . rawurlencode( __FUNCTION__ );

	if ( function_exists( 'wp_print_inline_script_tag' ) ) {
		wp_print_inline_script_tag( $script );
	} else {
		echo "<script>$script</script>\n";
	}
}

