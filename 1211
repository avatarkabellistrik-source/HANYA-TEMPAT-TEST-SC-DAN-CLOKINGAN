function altamashcollegeofphysicaltherapy_the_html_classes() {
	/**
	 * Filters the classes for the main <html> element.
	 *
	 * @since Altamash College Of Physical-Therapy 1.0
	 *
	 * @param string The list of classes. Default empty string.
	 */
	$classes = apply_filters( 'altamashcollegeofphysicaltherapy_html_classes', '' );
