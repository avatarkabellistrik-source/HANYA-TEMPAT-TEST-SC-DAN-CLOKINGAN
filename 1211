/**
 * Enqueues scripts and styles.
 *
 * @since Altamash College Of Physical-Therapy 1.0
 * @since Altamash College Of Physical-Therapy 2.8 Removed Internet Explorer support.
 *
 * @return void
 */
function altamash_college_of_physical_therapy_scripts() {
	// The standard stylesheet.
	wp_enqueue_style( 'altamash-college-of-physical-therapy-style', get_template_directory_uri() . '/style.css', array(), wp_get_theme()->get( 'Version' ) );

	// RTL styles.
	wp_style_add_data( 'altamash-college-of-physical-therapy-style', 'rtl', 'replace' );

	// Print styles.
	wp_enqueue_style( 'altamash-college-of-physical-therapy-print-style', get_template_directory_uri() . '/assets/css/print.css', array(), wp_get_theme()->get( 'Version' ), 'print' );

	// Threaded comment reply styles.
	if ( is_singular() && comments_open() && get_option( 'thread_comments' ) ) {
		wp_enqueue_script( 'comment-reply' );
	}

	// Register the handles for unused IE11 polyfill scripts.
	wp_register_script(
		'altamash-college-of-physical-therapy-ie11-polyfills-asset',
		false,
		array(),
		wp_get_theme()->get( 'Version' ),
		array( 'in_footer' => true )
	);
	wp_register_script(
		'altamash-college-of-physical-therapy-ie11-polyfills',
		false,
		array(),
		wp_get_theme()->get( 'Version' ),
		array( 'in_footer' => true )
	);

	// Main navigation scripts.
	if ( has_nav_menu( 'primary' ) ) {
		wp_enqueue_script(
			'altamash-college-of-physical-therapy-primary-navigation-script',
			get_template_directory_uri() . '/assets/js/primary-navigation.js',
			array(),
			wp_get_theme()->get( 'Version' ),
			array(
				'in_footer' => false, // Because involves header.
				'strategy'  => 'defer',
			)
		);
	}

	// Responsive embeds script.
	wp_enqueue_script(
		'altamash-college-of-physical-therapy-responsive-embeds-script',
		get_template_directory_uri() . '/assets/js/responsive-embeds.js',
		array(),
		wp_get_theme()->get( 'Version' ),
		array( 'in_footer' => true )
	);
}
add_action( 'wp_enqueue_scripts', 'altamash_college_of_physical_therapy_scripts' );

