/* === GOLD SNOWFALL LUXURY === */
.snow-wrap{
  position:fixed;
  inset:0;
  pointer-events:none;
  overflow:hidden;
  z-index:9999;
}

/* basic gold flake */
.snowflake{
  position:absolute;
  top:-10vh;
  width:8px;
  height:8px;
  border-radius:50%;

  background:
    radial-gradient(circle at 30% 30%, #eaec5f 0 35%, #fbf694 45%, #ffd43a 70%, #fbea94 80%);

  box-shadow:
    0 0 6px rgba(255,215,0,.8),
    0 0 12px rgba(255,223,120,.6);

  opacity:.95;

  animation:
    fall var(--dur,12s) linear var(--delay,0s) infinite,
    sway var(--sway,6s) ease-in-out var(--delay,0s) infinite alternate,
    shimmer 3s ease-in-out infinite;

  will-change: transform;
}

/* motion */
@keyframes fall {
  to { transform: translate3d(var(--drift, 0px), 110vh, 0) rotate(var(--rot, 180deg)); }
}

@keyframes sway {
  from { margin-left: -12px; }
  to { margin-left: 12px; }
}

/* subtle gold shimmer */
@keyframes shimmer {
  0%,100% {
    filter: brightness(1) drop-shadow(0 0 6px rgba(255, 213, 0, 0.7));
  }
  50% {
    filter: brightness(1.4) drop-shadow(0 0 14px rgb(255, 191, 0));
  }
}

/* size variations */
.snowflake.-sm {
  width:4px;
  height:4px;
  opacity:.85;
  box-shadow:
    0 0 4px rgba(255, 221, 0, 0.6);
}

.snowflake.-lg {
  width:12px;
  height:12px;
  opacity:.95;
  box-shadow:
    0 0 10px rgba(255, 217, 0, 0.9),
    0 0 18px rgba(255, 233, 120, 0.7);
}

/* prefers reduced motion */
@media (prefers-reduced-motion: reduce) {
  .snowflake { animation: none; }
