function returnHighlightNews() {

	$strHTML = "";

	$args = array(
		'posts_per_page'         => 3,
        'post__in'            => get_option( 'sticky_posts' ),
		'orderby'          => 'date',
		'order'            => 'DESC',
	);
	$my_posts = get_posts( $args );
	
	if( ! empty( $my_posts ) ){

		$strHTML = '<div class="row">';
		foreach ( $my_posts as $p ){

			$content = get_post_meta($p->ID);
			$image = wp_get_attachment_image_url ($content['highlight_image'][0], 'full');

			///print_r($content);

			$strHTML .= '<div class="col-md-4 news-box">';
			$strHTML .= '<img src="' . $image . '" />';
			$strHTML .= '<div class="news-box-copy">';
			$strHTML .= '<h3><a href="' . get_permalink( $p->ID ) . '">' . $p->post_title . '</a></h3>';
			$strHTML .= '<div class="news-date">' . get_the_date("F j, Y", $p->ID) . "</div>";
			$strHTML .= '</div>';
			$strHTML .= '</div>';
		}
		$strHTML .= '</div>';
	}

	return $strHTML;
}
add_shortcode('returnHighlightNews', 'returnHighlightNews');

   /**
  * by_weight
  */
  function by_weight($a, $b) {
	if ($a['weight'] == $b['weight']) {
		return 0;
	} else {
		return $a['weight'] < $b['weight'] ? -1 : 1;
	}
}

//Return All Work
function returnAllWork() {

	$strHTML = "";

	$gradient = ' gradient-greywhite2';

	$strHTML .= "<div class='container-fluid section-work-row" . $gradient . "'>";
	$strHTML .= "<div class='container'>";
	$strHTML .= "<div class='row'>";

	 //first, create an array of all projects
	 $param = array('orderby' => 't.id', 'limit' => '-1');
	 $work = pods('work');
	 $work->find($param);

	 $slot = 1;
	 
	 while($work->fetch()) {
		 $id = $work->display('id');
		 $title = $work->display('title');
		 $slug = $work->display('slug');
		 $acfContent = get_post_meta($id);
		 $order = $acfContent['order'][0];

		 $img = wp_get_attachment_image_src($acfContent['thumbnail_img'][0], 'full');

		$workArray[] = (['id' => $id, 'title' => $title, 'slug' => $slug, 'img' => $img, 'weight' => $order]);
	 }

	 if(isset($workArray)) {

		$recCount = 1;
		$totalCount = count($workArray,0);
		
		usort($workArray, 'by_weight');

		foreach($workArray as $item) {

			$strHTML .= "<div class='col-md-4'>";
			$strHTML .= "<div class='work-box'>";
			$strHTML .= "<a href='" . $item['slug'] . "#cs'>";
			$strHTML .= "<img src='" . $item['img'][0] . "' alt='" . $item['title'] . "' />";
			$strHTML .= "</a>";
			$strHTML .= "</div>";
			$strHTML .= "</div>";

			if($slot == 3 && $recCount < $totalCount) {

				if($gradient == ' gradient-greywhite2') {
					$gradient = ' gradient-grey63ud';
					$shadow = ' dark';
				} else {
					$gradient = ' gradient-greywhite2';
					$shadow = '';
				}

				$strHTML .= "</div></div></div>";
				$strHTML .= "<div class='container-fluid section-work-row" . $gradient . $shadow . "'>";
				$strHTML .= "<div class='container'>";
				$strHTML .= "<div class='row'>";
			}

			if($slot == 3) {
				$slot = 1;
			} else {
				$slot++;
			}

			$recCount++;
		}
	}

	$strHTML .= "</div></div></div>";

	 return $strHTML;

}
add_shortcode('returnAllWork', 'returnAllWork');

