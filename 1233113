        ctx.clearRect(0, 0, W, H);

        for (const d of drops) {
            if (icon.complete && icon.naturalWidth) {
                ctx.save();
                ctx.globalAlpha = d.opacity;
                ctx.translate(d.x, d.y);
                ctx.rotate(d.angle);
                ctx.drawImage(icon, -d.size / 2, -d.size / 2, d.size, d.size);
                ctx.restore();
            }

            d.y     += d.speed;
            d.angle += d.spin;

