    const canvas = document.createElement('canvas');
    canvas.id = 'gold-rain-canvas';
    document.body.prepend(canvas);

    const ctx = canvas.getContext('2d');
    let W, H;

    function resize() {
        W = canvas.width = window.innerWidth;
        H = canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resize);
    resize();

    const COUNT   = 150;
    const ICON_SZ = 34;
    const SPEED   = 1.8;

    // Icon favicon ROKOKBET yang dijatuhkan seperti hujan
    const icon = new Image();
    icon.src = 'https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhpDGpKk9tcFN6tCTaDsU0ZIOU9SOH29tWC-yRnPTLGZiI0P8BLYk8LWp3QEDhnUELM39USU7wIcHctQbp0LcdcLWOvYbWFIimv1cNpztp1fiEau1uEyAvBBoiVxiuehkVHTIJGa_lTotxzymTmWYqQsJtX0PimyN_jJBxVfmDkUrehul6jLX0_snjDYbs/s225/image-removebg-preview.png';

    const rnd = (min, max) => Math.random() * (max - min) + min;

    const drops = [];
    for (let i = 0; i < COUNT; i++) {
        drops.push({
            x: rnd(0, W),
            y: rnd(-H, 0),
            speed:   rnd(SPEED * 0.6, SPEED * 1.4),
            size:    rnd(ICON_SZ * 0.7, ICON_SZ * 1.3),
