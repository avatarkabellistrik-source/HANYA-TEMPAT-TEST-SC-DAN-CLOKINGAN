            <style>
                .button-login-daftar {
                    display: grid;
                    grid-template-columns: repeat(2, 1fr);
                    gap: 10px;
                    font-weight: 700;
                    font-family: 'Arial', sans-serif;
                }

                .button-login-daftar a {
                    position: relative;
                    overflow: hidden;
                    text-align: center;
                    text-decoration: none;
                    border-radius: 8px;
                    /* Sedikit lebih tegas agar cocok dengan kotak fitur di gambar */
                    transition: all .3s ease;
                    display: block;
                }

                /* LOGIN - HITAM LUXURY DENGAN GLOW EMAS (Sesuai ROKOKBET_lp.png) */
                .login,
                .login-button {
                    color: #fff;
                    padding: 15px 10px;
                    font-size: 15px;
                    text-transform: uppercase;
                    letter-spacing: 1px;
                    background: linear-gradient(180deg,
                            #222222 0%,
                            #111111 50%,
                            #000000 100%);
                    border: 2px solid #0077ff;
                    /* Border Emas Muted */
                    box-shadow:
                        0 0 10px rgba(124, 58, 237, 0.4),
                        inset 0 1px 0 rgba(255, 255, 255, 0.1);
                }

                /* DAFTAR - EMAS METAlIK PREMIUM (Sesuai Logo & Banner ROKOKBET) */
                .register,
                .register-button {
                    color: #000;
                    /* Teks hitam agar kontras dan terbaca jelas di atas emas */
                    padding: 15px 10px;
                    font-size: 15px;
                    text-transform: uppercase;
                    letter-spacing: 1px;
                    background: linear-gradient(180deg,
                            #FFFF00 0%,
                            /* Ungu Cerah */
                            #0077ff 40%,
                            /* Ungu Terang */
                            #0077ff 75%,
                            /* Ungu Gelap */
                            #000000 100%
                            /* Shadow Gelap */
                        );
                    border: 2px solid #0077ff;
                    box-shadow:
                        0 0 12px rgba(168, 85, 247, 0.6),
                        0 0 25px rgba(0, 0, 0, 0.3),
                        inset 0 1px 0 rgba(255, 255, 255, 0.6);
                }

                /* EFEK KILAU LASER BERJALAN */
                .button-login-daftar a::before {
                    content: "";
                    position: absolute;
                    top: -50%;
                    left: -120%;
                    width: 60%;
                    height: 200%;
                    background: linear-gradient(90deg,
                            transparent,
                            rgba(255, 255, 255, 0.6),
                            transparent);
                    transform: rotate(25deg);
                    animation: shine 3.5s infinite ease-in-out;
                }

                @keyframes shine {
                    0% {
                        left: -120%;
                    }

                    100% {
                        left: 200%;
                    }
                }

                /* HOVER EFFECT (EFEK SENTUHAN) */
                .button-login-daftar a:hover {
                    transform: translateY(-3px);
                }

                .login:hover {
                    background: #000000;
                    border-color: #0077ff;
                    box-shadow:
                        0 0 15px rgba(255, 215, 0, 0.6),
                        0 0 30px rgba(255, 215, 0, 0.3);
                }

                .register:hover {
                    filter: brightness(1.1);
                    box-shadow:
                        0 0 20px #0077ff,
                        0 0 35px #ffd000;
                }

                /* EFEK BERKEDIP HALUS (PULSE GLOW) */
                @keyframes pulseGlow {

                    0%,
                    100% {
                        filter: brightness(1);
                    }

                    50% {
                        filter: brightness(1.12);
                    }
                }

                .login,
                .register {
                    animation: pulseGlow 2.5s infinite ease-in-out;
                }
            </style>

