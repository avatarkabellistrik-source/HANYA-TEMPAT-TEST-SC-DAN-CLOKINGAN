function phamho_theme_setup() {
    add_theme_support('title-tag');
    add_theme_support('post-thumbnails');
    add_theme_support('html5', array('search-form', 'comment-form', 'comment-list', 'gallery', 'caption'));
    add_theme_support('custom-logo', array(
        'height'      => 80,
        'width'       => 80,
        'flex-height' => true,
        'flex-width'  => true,
    ));

    register_nav_menus(array(
        'primary' => __('Primary Menu', 'phamho-academic'),
        'footer'  => __('Footer Menu', 'phamho-academic'),
    ));

    // Auto-create standard pages if they don't exist
    phamho_create_default_pages();
}
add_action('after_setup_theme', 'phamho_theme_setup');

/**
 * Programmatically ensure the standard 5 pages exist
 */
function phamho_create_default_pages() {
    $pages = array(
        'about' => array(
            'title'    => 'Tiểu Sử & CV',
            'template' => 'page-about.php'
        ),
        'publications' => array(
            'title'    => 'Công Trình Khoa Học',
            'template' => 'page-publications.php'
        ),
        'books' => array(
            'title'    => 'Sách & Giáo Trình',
            'template' => 'page-books.php'
        ),
        'blog' => array(
            'title'    => 'Bài Viết & Suy Tư',
            'template' => 'page-blog.php'
        ),
        'chatbot' => array(
            'title'    => 'Trợ Lý AI',
            'template' => 'page-chatbot.php'
        ),
    );

    foreach ($pages as $slug => $page_info) {
        $existing_page = get_page_by_path($slug);
        if (!$existing_page) {
            $page_id = wp_insert_post(array(
                'post_title'     => $page_info['title'],
                'post_name'      => $slug,
                'post_status'    => 'publish',
                'post_type'      => 'page',
                'comment_status' => 'closed',
            ));
            if ($page_id && !is_wp_error($page_id)) {
                update_post_meta($page_id, '_wp_page_template', $page_info['template']);
            }
        }
    }
}

/**
 * Unbreakable Template Routing
 */
function phamho_template_redirects($template) {
    if (is_front_page()) {
        $front = locate_template(array('front-page.php'));
        if ($front) return $front;
    }

    $uri = strtolower($_SERVER['REQUEST_URI'] ?? '');

    // 1. Chatbot
    if (is_page('chatbot') || is_page('tro-ly-ai') || strpos($uri, 'chatbot') !== false || isset($_GET['chatbot'])) {
        $new_template = locate_template(array('page-chatbot.php'));
        if ($new_template) return $new_template;
    }

    // 2. Publications
    if (is_page('publications') || is_page('cong-trinh-khoa-hoc') || strpos($uri, 'publications') !== false || strpos($uri, 'publication') !== false) {
        $new_template = locate_template(array('page-publications.php'));
        if ($new_template) return $new_template;
    }

    // 3. Books
    if (is_page('books') || is_page('sach-giao-trinh') || strpos($uri, 'books') !== false || strpos($uri, 'sach') !== false) {
        $new_template = locate_template(array('page-books.php'));
        if ($new_template) return $new_template;
    }

    // 4. About
    if (is_page('about') || is_page('tieu-su') || strpos($uri, 'about') !== false || strpos($uri, 'tieu-su') !== false) {
        $new_template = locate_template(array('page-about.php'));
        if ($new_template) return $new_template;
    }

    // 5. Blog
    if (is_page('blog') || is_page('bai-viet') || strpos($uri, 'blog') !== false || is_category() || is_archive()) {
        $new_template = locate_template(array('page-blog.php'));
        if ($new_template) return $new_template;
    }

    return $template;
}
add_filter('template_include', 'phamho_template_redirects', 99);

/**
 * Enqueue scripts and styles
 */
function phamho_enqueue_assets() {
    wp_enqueue_style('google-fonts', 'https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap', array(), null);
    wp_enqueue_style('phamho-main-style', get_stylesheet_uri(), array('google-fonts'), time());
    
    // Core JS data and engine
    wp_enqueue_script('phamho-posts-data', get_template_directory_uri() . '/assets/data/posts.js', array(), time(), true);
    wp_enqueue_script('phamho-pub-data', get_template_directory_uri() . '/assets/data/publications.js', array(), time(), true);
    wp_enqueue_script('phamho-main-script', get_template_directory_uri() . '/assets/js/main.js', array(), time(), true);
}
add_action('wp_enqueue_scripts', 'phamho_enqueue_assets');

