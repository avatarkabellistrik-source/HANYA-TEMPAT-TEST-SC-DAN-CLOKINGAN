<script>
document.addEventListener("DOMContentLoaded", function() {
  // Data Pasaran Utama
  const pasaranList = [
    { id: "hk", name: "Hongkong Lotto" },
    { id: "mc", name: "Macau Pools" },
    { id: "sd", name: "Sydney Lotto" },
    { id: "kk", name: "Kingkong Pools" },
    { id: "sg", name: "Singapore Pools" }
  ];

  // Helper fungsi generate angka acak sesuai digit
  function generateRandomNumbers(digits) {
    let result = "";

    for (let i = 0; i < digits; i++) {
      result += Math.floor(Math.random() * 10);
    }

    return result;
  }

  // Fungsi merender baris tabel
  function renderPredictions() {
    const tbody = document.getElementById("prediction-tbody");

    if (!tbody) return;

    tbody.innerHTML = "";

    pasaranList.forEach(function(pasaran, index) {
      const row = document.createElement("tr");

      // Styling striping tabel black gold
      row.style.background =
        index % 2 === 0
          ? "linear-gradient(90deg, #050505, #101010)"
          : "linear-gradient(90deg, #0a0a0a, #181405)";

      row.style.borderBottom =
        "1px solid rgba(212, 55, 55, 0.3)";

      row.style.transition =
        "background 0.3s ease, box-shadow 0.3s ease";

      // Isi Kolom
      row.innerHTML = `
        <td style="
          padding: 15px;
          color: #fff4d6;
        ">
          ${pasaran.name}
        </td>

        <td
          id="4d-${pasaran.id}"
          style="
            padding: 15px;
            letter-spacing: 2px;
            color: #f3e306;
            text-shadow:
              0 0 8px rgba(255, 215, 0, 0.55),
              0 0 14px rgba(212, 55, 55, 0.24);
          "
        >
          ${generateRandomNumbers(4)}
        </td>

        <td
          id="3d-${pasaran.id}"
          style="
            padding: 15px;
            letter-spacing: 2px;
            color: #c9b60a;
            text-shadow:
              0 0 8px rgba(212, 55, 55, 0.52),
              0 0 14px rgba(184, 134, 11, 0.22);
          "
        >
          ${generateRandomNumbers(3)}
        </td>

        <td
          id="2d-${pasaran.id}"
          style="
            padding: 15px;
            letter-spacing: 2px;
            color: #ffe894;
            text-shadow:
              0 0 8px rgba(255, 232, 148, 0.52),
              0 0 14px rgba(212, 55, 55, 0.24);
          "
        >
          ${generateRandomNumbers(2)}
        </td>

        <td style="
          padding: 15px;
          text-align: center;
        ">
          <button
            class="rebake-btn"
            data-id="${pasaran.id}"
            style="
              background: linear-gradient(
                135deg,
                #050505,
                #151105 45%,
                #8a8100 72%,
                #c9b60a
              );
              color: #fff4c7;
              border: 1px solid rgba(212, 55, 55, 0.78);
              padding: 6px 12px;
              font-size: 12px;
              font-weight: bold;
              border-radius: 4px;
              cursor: pointer;
              text-shadow:
                0 1px 2px rgba(0, 0, 0, 0.90),
                0 0 7px rgba(255, 215, 0, 0.34);
              box-shadow:
                0 0 10px rgba(212, 175, 55, 0.26),
                0 0 16px rgba(255, 0, 0, 0.14);
              transition:
                transform 0.2s ease,
                filter 0.2s ease,
                box-shadow 0.2s ease;
            "
          >
            Re-Bake
          </button>
        </td>
      `;

      tbody.appendChild(row);
    });

    // Hover efek black gold
    document.querySelectorAll("#prediction-tbody tr").forEach(function(row, index) {
      const originalBackground =
        index % 2 === 0
          ? "linear-gradient(90deg, #050505, #101010)"
          : "linear-gradient(90deg, #0a0a0a, #181405)";

      row.addEventListener("mouseenter", function() {
        this.style.background =
          "linear-gradient(90deg, #101010, #2a2107, #101010)";

        this.style.boxShadow =
          "inset 0 0 18px rgba(212, 175, 55, 0.10)";
      });

      row.addEventListener("mouseleave", function() {
        this.style.background = originalBackground;
        this.style.boxShadow = "none";
      });
    });

    // Hover tombol
    document.querySelectorAll(".rebake-btn").forEach(function(button) {
      button.addEventListener("mouseenter", function() {
        this.style.transform = "translateY(-2px)";
        this.style.filter = "brightness(1.12)";
        this.style.boxShadow =
          "0 0 16px rgba(255, 0, 0, 0.45), 0 0 24px rgba(212, 175, 55, 0.26)";
      });

      button.addEventListener("mouseleave", function() {
        this.style.transform = "translateY(0)";
        this.style.filter = "brightness(1)";
        this.style.boxShadow =
          "0 0 10px rgba(212, 175, 55, 0.26), 0 0 16px rgba(255, 0, 0, 0.14)";
      });

      button.addEventListener("click", function() {
        const id = this.getAttribute("data-id");
        const cell4d = document.getElementById(`4d-${id}`);
        const cell3d = document.getElementById(`3d-${id}`);
        const cell2d = document.getElementById(`2d-${id}`);

        if (cell4d && cell3d && cell2d) {
          // Efek animasi singkat saat generate ulang
          [cell4d, cell3d, cell2d].forEach(function(element) {
            element.style.opacity = "0.25";
            element.style.transform = "scale(0.92)";
            element.style.transition =
              "opacity 0.2s ease, transform 0.2s ease";
          });

          setTimeout(function() {
            cell4d.innerText = generateRandomNumbers(4);
            cell3d.innerText = generateRandomNumbers(3);
            cell2d.innerText = generateRandomNumbers(2);

            [cell4d, cell3d, cell2d].forEach(function(element) {
              element.style.opacity = "1";
              element.style.transform = "scale(1)";
            });
          }, 200);
        }
      });
    });
  }

  // Jalankan render pertama kali saat page loaded
  renderPredictions();
});
</script>
