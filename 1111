        transform: rotate(30deg);
        transition: transform 0.6s ease;
        pointer-events: none;
      }
      
      .glow-on-hover:hover::after {
        transform: rotate(30deg) translate(20%, 20%);
      }
      
      /* ===== GRID BUTTONS ===== */
      .button-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
        margin-top: 10px;
