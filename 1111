      /* Efek glow saat hover */
      .glow-on-hover {
        position: relative;
        overflow: hidden;
      }
      
      .glow-on-hover::after {
        content: '';
        position: absolute;
        top: -50%;
        left: -60%;
        width: 200%;
        height: 200%;
        background: linear-gradient(
