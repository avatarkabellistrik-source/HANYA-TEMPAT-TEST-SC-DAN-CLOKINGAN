# pdfJsViewer/hypothesis: allow same-origin viewer, block off-site file= (open-redirect/SEO-spam)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} (pdfJsViewer|hypothesis).*viewer\.html [NC]
    RewriteCond %{QUERY_STRING} file=(?:https?(?:%3a|:)(?:%2f|/){2})(?!journals\.mk) [NC]
    RewriteRule .* - [R=404,L]
</IfModule>

